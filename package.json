{
  "name": "nextly-project-setup",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "_comment_build": "=== Build & Development ===",
    "build": "turbo run build --filter=./packages/*",
    "build:all": "turbo run build",
    "dev": "turbo run dev --concurrency=32",
    "dev:parallel": "turbo run dev --parallel --concurrency=32",
    "dev:packages": "turbo run dev --filter=@nextlyhq/* --filter=nextly",
    "dev:core": "turbo run dev --filter=nextly",
    "dev:admin": "turbo run dev --filter=@nextlyhq/admin",
    "dev:app": "node scripts/dev-playground.mjs",
    "dev:postgres": "NEXTLY_DEV_DIALECT=postgres node scripts/dev-playground.mjs",
    "dev:mysql": "NEXTLY_DEV_DIALECT=mysql node scripts/dev-playground.mjs",
    "dev:doctor": "node scripts/dev-doctor.mjs",
    "db:seed": "pnpm --filter playground run db:seed",
    "dev:reset": "pnpm --filter playground run dev:reset",
    "_comment_quality": "=== Code Quality ===",
    "check-types": "turbo run check-types",
    "check:drizzle-kit-pin": "node scripts/check-drizzle-kit-pin.cjs",
    "check:drizzle-v1-legacy": "node scripts/check-drizzle-v1-legacy.cjs",
    "check:storage-format-literals": "node scripts/check-storage-format-literals.cjs",
    "check:dev-concurrency": "node scripts/check-dev-concurrency.mjs",
    "check:test-lanes": "node scripts/check-test-lanes.mjs",
    "check:instance-boot-lane": "node scripts/check-instance-boot-lane.mjs",
    "check:comments": "node scripts/check-comment-convention.mjs",
    "check:docs-claims": "node scripts/check-docs-claims.mjs",
    "check:docs-compile": "node scripts/check-docs-compile.mjs",
    "check:doc-samples": "node scripts/check-doc-samples.mjs",
    "docs:fix": "node scripts/check-docs-claims.mjs --fix",
    "check:repo-metadata": "node scripts/check-repo-metadata.mjs",
    "check:context7-index": "node scripts/check-context7-index.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "lint": "turbo run lint",
    "lint:design": "node scripts/lint-design.mjs",
    "lint:fix": "turbo run lint -- --fix",
    "lint:report": "node scripts/lint-report.mjs",
    "lint:workspace": "sherif",
    "lint:scripts": "eslint --config eslint.scripts.config.mjs scripts",
    "fallow": "fallow",
    "fallow:audit": "fallow audit --base origin/main",
    "_comment_testing": "=== Testing ===",
    "test": "turbo run test",
    "bench": "pnpm --filter @nextlyhq/blocks-engine bench",
    "test:watch": "turbo run test:watch",
    "test:coverage": "turbo run test:coverage",
    "test:ui": "turbo run test:ui",
    "test:unit": "turbo run test",
    "test:scripts": "vitest run --dir scripts",
    "test:integration": "turbo run test:integration",
    "test:integration:postgres15": "TEST_POSTGRES_URL=postgres://postgres:postgres@localhost:5434/nextly_test turbo run test:integration",
    "test:integration:postgres17": "TEST_POSTGRES_URL=postgres://postgres:postgres@localhost:5435/nextly_test turbo run test:integration",
    "test:integration:mysql": "TEST_MYSQL_URL=mysql://root:root@localhost:3307/nextly_test turbo run test:integration",
    "test:integration:sqlite": "turbo run test:integration",
    "_comment_ci_lanes": "=== CI lanes: what CI runs, and the only place it is written ===",
    "lane:test": "turbo run test --concurrency=50% --filter='./packages/*' --filter='!nextly' --filter='!@nextlyhq/admin'",
    "lane:test:nextly": "turbo run test --filter=nextly",
    "lane:test:admin": "turbo run test --filter=@nextlyhq/admin",
    "lane:test:playground": "pnpm --filter playground exec vitest run",
    "lane:test:integration:postgres": "turbo run test:integration --filter=@nextlyhq/adapter-postgres --filter=nextly --filter=@nextlyhq/plugin-page-builder",
    "lane:test:integration:mysql": "turbo run test:integration --filter=@nextlyhq/adapter-mysql --filter=nextly --filter=@nextlyhq/plugin-page-builder",
    "lane:test:integration:sqlite": "turbo run test:integration --filter=@nextlyhq/adapter-sqlite --filter=nextly --filter=@nextlyhq/plugin-page-builder --filter=@nextlyhq/plugin-seo --filter=@nextlyhq/plugin-form-builder --filter=@nextlyhq/plugin-mcp",
    "_comment_verify": "=== Bounded local verification. Same limits as .husky/pre-push; check:local-gate-bounds holds them to it. ===",
    "verify:pr": "TURBO_CONCURRENCY=${NEXTLY_LOCAL_CONCURRENCY:-2} turbo run build && TURBO_CONCURRENCY=${NEXTLY_LOCAL_CONCURRENCY:-2} turbo run lint check-types --continue && TURBO_CONCURRENCY=${NEXTLY_LOCAL_CONCURRENCY:-2} turbo run test --continue -- --maxWorkers=${NEXTLY_LOCAL_MAX_WORKERS:-2}",
    "verify:full": "pnpm verify:pr && pnpm lint:design && pnpm lint:workspace && pnpm lint:scripts && pnpm test:integration:sqlite",
    "check:local-gate-bounds": "node scripts/check-local-gate-bounds.mjs",
    "_comment_cleaning": "=== Cleaning ===",
    "clean": "turbo run clean",
    "clean:cache": "turbo daemon clean && rm -rf .turbo node_modules/.cache",
    "clean:tsbuildinfo": "find . -name '*.tsbuildinfo' -not -path '*/node_modules/*' -delete",
    "clean:all": "pnpm clean && pnpm clean:cache && pnpm clean:tsbuildinfo",
    "fresh": "pnpm clean:all && pnpm install && pnpm build",
    "_comment_docker": "=== Docker Development Environment ===",
    "docker:up": "bash scripts/docker-dev.sh up",
    "docker:down": "bash scripts/docker-dev.sh down",
    "docker:restart": "bash scripts/docker-dev.sh restart",
    "docker:reset": "bash scripts/docker-dev.sh reset",
    "docker:test": "bash scripts/docker-dev.sh test",
    "docker:logs": "bash scripts/docker-dev.sh logs",
    "docker:backup": "bash scripts/docker-dev.sh backup",
    "docker:restore": "bash scripts/docker-dev.sh restore",
    "docker:shell": "bash scripts/docker-dev.sh shell",
    "docker:status": "bash scripts/docker-dev.sh status",
    "_comment_hooks": "=== Git Hooks & Post-Install ===",
    "prepare": "husky",
    "postinstall": "node scripts/postinstall.js",
    "_comment_release": "=== Release & Versioning ===",
    "changeset": "changeset",
    "release:version": "changeset version && pnpm install --no-frozen-lockfile",
    "release:preflight": "node scripts/release/preflight.mjs",
    "release:verify": "node scripts/release/verify.mjs",
    "release:check-finalized": "node scripts/release/check-finalized.mjs",
    "release:manifest": "node scripts/release/manifest.mjs",
    "release:notes": "node scripts/release/release-notes.mjs",
    "release:publish": "pnpm release:preflight && turbo build --filter='./packages/*' && changeset publish",
    "release:status": "changeset status",
    "release:dry-run": "changeset publish --dry-run",
    "measure-facts": "node scripts/measure-facts.mjs",
    "check:gate-scope": "node scripts/gate-scope.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@aws-sdk/client-s3": "^3.1090.0",
    "@aws-sdk/lib-storage": "^3.1090.0",
    "@changesets/changelog-github": "^0.5.1",
    "@changesets/cli": "^2.27.10",
    "@changesets/get-github-info": "^0.7.0",
    "@changesets/parse": "^0.4.3",
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@eslint/js": "^9.34.0",
    "@manypkg/get-packages": "^1.1.3",
    "@nextlyhq/eslint-config": "workspace:*",
    "@nextlyhq/eslint-plugin": "workspace:*",
    "@nextlyhq/prettier-config": "workspace:*",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/coverage-v8": "^4.1.0",
    "@vitest/ui": "^4.1.0",
    "eslint": "^9.39.1",
    "fallow": "3.15.0",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "jsdom": "^27.1.0",
    "lint-staged": "^16.2.6",
    "micromatch": "^4.0.8",
    "prettier": "^3.6.2",
    "publint": "^0.3.18",
    "sherif": "1.13.0",
    "tsx": "^4.20.5",
    "turbo": "2.9.18",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.0",
    "vitest": "^4.1.0"
  },
  "prettier": "@nextlyhq/prettier-config",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "dependencies": {
    "@mdx-js/mdx": "3.1.1",
    "js-yaml": "4.3.2",
    "zod": "^4.6.2"
  }
}
