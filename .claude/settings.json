{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "FALLOW_AUDIT_BASE": "origin/main"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
