# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
node_modules
.pnpm-store

# Local env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Ignore migrations & schema for local development
# Ignore all files in migrations and schemas
apps/playground/src/db/migrations/**/*
apps/playground/src/db/schemas/**/*

# But keep the folder structure and empty index.ts
!apps/playground/src/db/migrations/dynamic/
!apps/playground/src/db/migrations/dynamic/.gitkeep
!apps/playground/src/db/schemas/dynamic/
!apps/playground/src/db/schemas/dynamic/.gitkeep
!apps/playground/src/db/schemas/dynamic/index.ts

# Ignore generated collection schemas (but keep index.ts)
apps/playground/src/db/schemas/dynamic/*.ts
!apps/playground/src/db/schemas/dynamic/index.ts

# Claude Code: local config stays ignored, shared rules/skills are committed
.claude/*
!.claude/rules/
!.claude/skills/
# The fallow agent gate is a control, not a preference: it blocks an agent's
# `git commit`/`git push` when a whole-graph audit fails. Shared for the same
# reason rules and skills are — one that only exists on the machine that ran
# the installer enforces nothing for anyone else.
#
# Committing it also puts a script that RUNS ON A MAINTAINER'S MACHINE into a
# public repository, so a pull request can propose a change to it. Claude Code
# prompts when hook configuration changes and the gate fails open, so this is
# not an open door — but treat `.claude/hooks/` as review-critical rather than
# as configuration, and read a diff to it the way you would read one to CI.
!.claude/settings.json
!.claude/hooks/

# Testing
coverage

# Turbo
.turbo

# Vercel
.vercel

# Build Outputs
.next/
# Build directory for the browser suite's own dev server (see e2e/playwright.config.ts).
.next-e2e/
# And for the production exit demo, which builds rather than serving from source
# (see e2e/playwright.production.config.ts). A separate directory because two
# Next processes on one app fight over the same one.
.next-e2e-prod/
# And for the nightly Lighthouse run, which builds the playground for
# production on its own port (see .github/workflows/lighthouse.yml).
.next-lighthouse/
out/
build
dist

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
.DS_Store
*.pem
*.tsbuildinfo

# VS Code Local History extension
.history/

# Docker (local overrides and generated files)
.env.docker.local
backups/
docker/postgres/data/

# SQLite database files
apps/playground/data/
# The nextly package's own SQLite tests default to `file:./data/nextly.db` when
# no DATABASE_URL is set, so running them from `packages/nextly` leaves a
# database file there. Untracked and unignored, it is one `git add -A` away
# from being committed into a pull request.
packages/nextly/data/

# Nextly runtime artifacts (migration logs, journal) written next to any app/package
.nextly/

# Bundled templates copied into create-nextly-app during build (build artifact)
packages/create-nextly-app/templates/

# Kept in the working tree for local reference but never published.
.internal-docs/

# Personal yalc tooling — kept locally for testing publishable packages
# in external sandbox apps, not part of the public contributor workflow.
scripts/yalc-publish.sh
.yalc/
yalc.lock

# Playwright MCP session artifacts (browser snapshots + console logs).
# Generated during local debugging sessions, never part of a commit.
.playwright-mcp/

# Browser-test output: the HTML report, traces, screenshots and per-run
# results. Regenerated by every run. The suite itself (e2e/tests, its config
# and helpers) is source and is committed — only what a run produces is not.
e2e/.playwright/

# Local-only planning/spec docs (superpowers brainstorm + plan artifacts)
# and hands-on local testing playbooks. Kept on disk for reference, never
# committed.
docs/superpowers/
docs/guides/manual-testing-migrations.md
docs/guides/testing-migrations.md

# Generated dynamic migrations leaked when the package src is used as an app root in tests/playground
packages/nextly/src/db/migrations/dynamic/*.sql
.nextly-review/

# fallow's analysis cache: the resolved module graph, per-file churn and
# incremental state, rebuilt from the tree on demand. It self-ignores, so its
# contents stay out of `git status` either way — named here so the directory
# reads as build output rather than as something git merely happens to miss.
.fallow/
# Task trackers and working notes live beside the task files at the workspace
# root, outside this repository: they are internal planning, and this repo is
# public. Ignored here so a worktree cannot commit one by accident.
/tasks/

# tsup writes a bundled copy of its config while building and removes it on
# exit. A watcher killed mid-run leaves one behind, and an untracked build
# artifact in a package root fails the next lint rather than being ignored.
tsup.config.bundled_*.mjs
tsup.config.bundled_*.cjs
tsup.*.config.bundled_*.mjs
tsup.*.config.bundled_*.cjs

# Working directory and dumped reports from the nightly Lighthouse run; the run
# uploads them as an artifact rather than committing them.
.lighthouseci/
lighthouse-reports/
