{
  "formatVersion": 1,
  "kind": "page",
  "nodes": [
    {
      "id": "dogfood-hero",
      "type": "core/section",
      "version": 1,
      "props": { "as": "header", "contained": true },
      "slots": {
        "children": [
          {
            "id": "dogfood-title",
            "type": "core/heading",
            "version": 1,
            "props": { "text": "Build pages, not pipelines", "level": "h1" }
          },
          {
            "id": "dogfood-lede",
            "type": "core/text",
            "version": 1,
            "props": {
              "text": "Nextly gives editors a real page builder and gives developers a typed schema, one database and no bespoke CMS glue. This page is a block document, authored through the same API the editor writes with and served from a production build."
            }
          },
          {
            "id": "dogfood-hero-image",
            "type": "core/image",
            "version": 1,
            "props": {
              "mediaId": "@media:sample-1.webp",
              "alt": "A page open in the Nextly editor, with the block palette beside the canvas",
              "loading": "eager"
            }
          },
          {
            "id": "dogfood-cta",
            "type": "core/button",
            "version": 1,
            "props": {
              "label": "Read the documentation",
              "href": "https://nextly.dev/docs",
              "type": "primary"
            }
          }
        ]
      }
    },
    {
      "id": "dogfood-body",
      "type": "core/section",
      "version": 1,
      "props": { "as": "main", "contained": true },
      "slots": {
        "children": [
          {
            "id": "dogfood-features-title",
            "type": "core/heading",
            "version": 1,
            "props": { "text": "What you get", "level": "h2" }
          },
