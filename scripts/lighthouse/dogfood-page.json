            "props": { "as": "div", "contained": false },
            "slots": {
              "children": [
                {
                  "id": "dogfood-column-schema",
                  "type": "core/column",
                  "version": 1,
                  "props": { "as": "div" },
                  "slots": {
                    "children": [
                      {
                        "id": "dogfood-column-schema-title",
                        "type": "core/heading",
                        "version": 1,
                        "props": { "text": "A typed schema", "level": "h3" }
                      },
                      {
                        "id": "dogfood-column-schema-body",
                        "type": "core/text",
                        "version": 1,
                        "props": {
                          "text": "Collections are declared in TypeScript and the generated types follow, so renaming a field is a compile error rather than a runtime surprise."
                        }
                      }
                    ]
                  }
                },
                {
                  "id": "dogfood-column-editor",
                  "type": "core/column",
                  "version": 1,
                  "props": { "as": "div" },
                  "slots": {
                    "children": [
                      {
                        "id": "dogfood-column-editor-title",
                        "type": "core/heading",
                        "version": 1,
                        "props": { "text": "A real editor", "level": "h3" }
                      },
                      {
                        "id": "dogfood-column-editor-body",
                        "type": "core/text",
                        "version": 1,
                        "props": {
                          "text": "The page builder writes the same block document the renderer reads, so what an author arranges is what a visitor is served."
                        }
                      }
                    ]
                  }
                },
                {
                  "id": "dogfood-column-database",
                  "type": "core/column",
                  "version": 1,
                  "props": { "as": "div" },
                  "slots": {
                    "children": [
                      {
                        "id": "dogfood-column-database-title",
                        "type": "core/heading",
                        "version": 1,
                        "props": { "text": "One database", "level": "h3" }
                      },
                      {
                        "id": "dogfood-column-database-body",
                        "type": "core/text",
                        "version": 1,
                        "props": {
                          "text": "Postgres, MySQL or SQLite behind one adapter, with migrations generated from the schema you already wrote."
                        }
                      }
                    ]
                  }
                }
