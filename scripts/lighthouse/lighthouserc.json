{
  "ci": {
    "collect": {
      "url": ["http://localhost:3111/"],
      "numberOfRuns": 5,
      "settings": {
        "preset": "desktop",
        "throttlingMethod": "simulate",
        "chromeFlags": "--no-sandbox --disable-gpu --headless=new"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          { "minScore": 0.95, "aggregationMethod": "median" }
        ],
        "categories:accessibility": [
          "error",
          { "minScore": 1, "aggregationMethod": "median" }
        ],
        "categories:best-practices": [
          "error",
          { "minScore": 1, "aggregationMethod": "median" }
        ],
        "categories:seo": [
          "error",
          { "minScore": 1, "aggregationMethod": "median" }
        ],
        "resource-summary:script:count": [
          "error",
          { "maxNumericValue": 30, "aggregationMethod": "median" }
        ],
        "resource-summary:script:size": [
          "error",
          { "maxNumericValue": 1000000, "aggregationMethod": "median" }
        ],
        "resource-summary:total:size": [
          "error",
          { "maxNumericValue": 1100000, "aggregationMethod": "median" }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci-report",
      "reportFilenamePattern": "%%PATHNAME%%-%%DATETIME%%-report.%%EXTENSION%%"
    }
  }
}
