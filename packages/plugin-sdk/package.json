{
  "name": "@nextlyhq/plugin-sdk",
  "version": "0.0.2-alpha.72",
  "description": "Nextly Plugin SDK — the author-facing surface for building Nextly plugins; the plugin API stability boundary (see STABILITY.md).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nextlyhq/nextly.git",
    "directory": "packages/plugin-sdk"
  },
  "homepage": "https://nextlyhq.com/docs/plugins",
  "bugs": {
    "url": "https://github.com/nextlyhq/nextly/issues"
  },
  "type": "module",
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./blocks": {
      "types": "./dist/blocks.d.ts",
      "import": "./dist/blocks.mjs",
      "default": "./dist/blocks.mjs"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.mjs",
      "default": "./dist/testing.mjs"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.mjs",
      "default": "./dist/client.mjs"
    },
    "./admin": {
      "types": "./dist/admin.d.ts",
      "import": "./dist/admin.mjs",
      "default": "./dist/admin.mjs"
    },
    "./db": {
      "types": "./dist/db.d.ts",
      "import": "./dist/db.mjs",
      "default": "./dist/db.mjs"
    },
    "./routing": {
      "types": "./dist/routing.d.ts",
      "import": "./dist/routing.mjs",
      "default": "./dist/routing.mjs"
    },
    "./widgets": {
      "types": "./dist/widgets.d.ts",
      "import": "./dist/widgets.mjs",
      "default": "./dist/widgets.mjs"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.mjs",
      "default": "./dist/schema.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "check-types": "node ../../scripts/tsc.mjs --noEmit && node ../../scripts/tsc.mjs --noEmit -p tsconfig.tests.json",
    "clean": "rimraf dist",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "dependencies": {
    "@nextlyhq/blocks-engine": "workspace:*"
  },
  "peerDependencies": {
    "@nextlyhq/admin": "workspace:*",
    "nextly": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "peerDependenciesMeta": {
    "@nextlyhq/admin": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nextlyhq/admin": "workspace:*",
    "@nextlyhq/tsconfig": "workspace:*",
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "nextly": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsdown": "^0.23.1",
    "typescript": "7.0.2",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "keywords": [
    "nextly",
    "plugin",
    "sdk",
    "nextly-plugin"
  ]
}
