{
  "extends": "@nextlyhq/tsconfig/base-bundler.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "types": [],
    // Every export states its type, so tsdown can write the published
    // declarations with oxc, one file at a time and without a type checker.
    "isolatedDeclarations": true
  },
  "include": ["src/**/*"],
  // The tests, type tests and render tests alike, are checked by
  // tsconfig.tests.json, where exports need not state their types: they
  // publish nothing.
  "exclude": [
    "dist",
    "node_modules",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.test-d.ts"
  ]
}
