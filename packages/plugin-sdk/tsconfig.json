{
  "extends": "@nextlyhq/tsconfig/base-bundler.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "types": [],
    // Every export states its type, so tsdown can write the published
    // declarations with oxc, one file at a time and without a type checker.
    "isolatedDeclarations": true
  },
  "include": ["src/**/*"],
  // The type tests are checked by tsconfig.tests.json, where exports need not
  // state their types: they publish nothing.
  "exclude": ["dist", "node_modules", "**/*.test.ts", "**/*.test-d.ts"]
}
