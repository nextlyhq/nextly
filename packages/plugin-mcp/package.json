{
  "name": "@nextlyhq/plugin-mcp",
  "version": "0.0.2-alpha.72",
  "description": "Experimental: serves a Model Context Protocol endpoint for AI agents, off by default and authenticated like every other Nextly route. Read-only, and the one tool it exposes reports what the connecting credential may read",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "check-types": "node ../../scripts/tsc.mjs --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@nextlyhq/plugin-sdk": "workspace:*",
    "nextly": "0.0.2-alpha.72"
  },
  "devDependencies": {
    "@nextlyhq/plugin-sdk": "workspace:*",
    "@nextlyhq/tsconfig": "workspace:*",
    "@types/node": "^22.20.5",
    "nextly": "workspace:*",
    "tsdown": "^0.23.1",
    "typescript": "7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "keywords": [
    "nextly",
    "nextly-plugin",
    "plugin",
    "mcp",
    "model-context-protocol",
    "ai",
    "agents",
    "cms",
    "headless-cms"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nextlyhq/nextly.git",
    "directory": "packages/plugin-mcp"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "homepage": "https://nextlyhq.com",
  "bugs": {
    "url": "https://github.com/nextlyhq/nextly/issues"
  },
  "author": "Nextly <contact@nextlyhq.com> (https://nextlyhq.com)"
}
