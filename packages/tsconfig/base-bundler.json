{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./base.json",
  "compilerOptions": {
    // Module syntax checked as the bundler keeps it, which is what tsdown and
    // Next do with it: TypeScript's advice for code a bundler builds.
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "composite": false,
    "noEmit": true
  }
}
