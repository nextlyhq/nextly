{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "incremental": true,
    // `${configDir}` resolves to the directory of the config that EXTENDS this
    // one, not to this file's own directory. A plain relative path here does
    // the latter, which pointed every package in the workspace at
    // `packages/tsconfig/.tsbuildinfo` — one shared file that each `tsc` run
    // overwrote in turn, so incremental state was always another package's and
    // parallel runs raced to write it. It also sat outside every package's own
    // directory, so turbo's package-scoped `outputs` never matched and 21
    // packages logged `no output files found` on every run.
    //
    // Removing the option was not an alternative while tsup built the
    // declarations: its dts step drove tsc through flags rather than a config
    // file, where `--incremental` without an explicit `--tsBuildInfoFile` is
    // TS5074. tsdown's declaration step writes no build info at all.
    "tsBuildInfoFile": "${configDir}/.tsbuildinfo",
    "isolatedModules": true,
    // An import or export that names only types says so (`import type`), and
    // every other one is kept as written. One file at a time is all a
    // transformer like oxc sees, so it can only drop what the syntax marks.
    "verbatimModuleSyntax": true,
    // TypeScript 7's defaults, written out so 5.9 checks the same way now:
    // a side-effect import (`import "./x"`) must resolve, and `lib` files are
    // never replaced by a package named `@typescript/lib-*`.
    "libReplacement": false,
    "noUncheckedSideEffectImports": true,
    // No `DOM.Iterable`: it has been an empty file since TypeScript 6.0, with
    // the iterable DOM declarations folded into `DOM` itself.
    "lib": ["es2024", "DOM"],
    "module": "NodeNext",
    "moduleDetection": "force",
    "moduleResolution": "NodeNext",
    "noUncheckedIndexedAccess": false,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    // The newest syntax the supported Node floor (22.12) runs. Only for checking:
    // what is emitted, and for which runtime, is tsdown's `target`.
    "target": "ES2024"
  }
}
