{
  "name": "@nextlyhq/module-specifiers",
  "version": "0.0.2-alpha.68",
  "description": "One AST reader for the module specifiers a source file loads. Consumed only by layering guards inside this repository; exports TypeScript source and is never published or bundled.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./parse-source": {
      "types": "./src/parse-source.d.mts",
      "default": "./src/parse-source.mjs"
    },
    "./declaration-exports": {
      "types": "./src/declaration-exports.d.mts",
      "default": "./src/declaration-exports.mjs"
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit --checkers 4",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@nextlyhq/tsconfig": "workspace:*",
    "@types/node": "^22.20.5",
    "typescript": "7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "dependencies": {
    "oxc-parser": "^0.155.0"
  }
}
