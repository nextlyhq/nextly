{
  "name": "@nextlyhq/plugin-commerce",
  "version": "0.0.2-alpha.68",
  "private": true,
  "description": "Commerce for Nextly: exact money, and the catalogue and payment contracts every provider plugin implements",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js",
      "default": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "check-types": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "zod": "^4.6.2"
  },
  "peerDependencies": {
    "@nextlyhq/plugin-sdk": "workspace:*",
    "nextly": "0.0.2-alpha.68"
  },
  "devDependencies": {
    "@nextlyhq/plugin-sdk": "workspace:*",
    "@nextlyhq/tsconfig": "workspace:*",
    "@types/node": "^22.20.5",
    "fast-check": "^3.23.2",
    "nextly": "workspace:*",
    "tsdown": "^0.23.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "keywords": [
    "nextly",
    "nextly-plugin",
    "plugin",
    "commerce",
    "ecommerce",
    "payments",
    "cms",
    "headless-cms"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nextlyhq/nextly.git",
    "directory": "packages/plugin-commerce"
  },
  "homepage": "https://nextlyhq.com",
  "bugs": {
    "url": "https://github.com/nextlyhq/nextly/issues"
  },
  "author": "Nextly <contact@nextlyhq.com> (https://nextlyhq.com)"
}
