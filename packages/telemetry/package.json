{
  "name": "@nextlyhq/telemetry",
  "version": "0.0.2-alpha.69",
  "description": "Internal anonymous telemetry client used by create-nextly-app and the nextly CLI. Not published to npm; bundled into consumers by tsdown.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "check-types": "node ../../scripts/tsc.mjs --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "conf": "^13.1.0",
    "env-paths": "^3.0.0",
    "picocolors": "^1.1.1",
    "posthog-node": "^5.56.4"
  },
  "devDependencies": {
    "@nextlyhq/tsconfig": "workspace:*",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.5",
    "rimraf": "^6.1.3",
    "tsdown": "^0.23.1",
    "typescript": "7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  }
}
