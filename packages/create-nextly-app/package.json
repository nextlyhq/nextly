{
  "name": "create-nextly-app",
  "version": "0.0.2-alpha.68",
  "description": "CLI to scaffold Nextly in your Next.js project",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "bin": {
    "create-nextly-app": "./bin/create-nextly-app.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "bin",
    "skills",
    "templates"
  ],
  "scripts": {
    "build": "tsdown --config-loader tsx",
    "dev": "tsdown --config-loader tsx --watch",
    "check-types": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@babel/parser": "^7.29.7",
    "@clack/prompts": "^1.8.1",
    "commander": "^14.0.2",
    "dotenv-expand": "10.0.0",
    "execa": "^9.6.0",
    "fs-extra": "^11.4.1",
    "picocolors": "^1.1.1",
    "picomatch": "^4.0.5",
    "tar": "^7.5.19",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@babel/types": "^7.29.7",
    "@nextlyhq/eslint-plugin": "workspace:*",
    "@nextlyhq/module-specifiers": "workspace:*",
    "@nextlyhq/telemetry": "workspace:*",
    "@nextlyhq/tsconfig": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.20.5",
    "@types/picomatch": "^4.0.3",
    "@types/tar": "^6.1.13",
    "@typescript-eslint/parser": "^8.59.0",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "eslint": "^9.39.1",
    "jsdom": "^27.1.0",
    "oxc-parser": "^0.155.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsdown": "^0.23.1",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "keywords": [
    "nextly",
    "cms",
    "nextjs",
    "cli",
    "scaffold",
    "create-nextly-app",
    "create-app"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nextlyhq/nextly.git",
    "directory": "packages/create-nextly-app"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "homepage": "https://nextlyhq.com",
  "bugs": {
    "url": "https://github.com/nextlyhq/nextly/issues"
  },
  "author": "Nextly <contact@nextlyhq.com> (https://nextlyhq.com)"
}
