{
  "name": "@nextlyhq/storage-s3",
  "version": "0.0.2-alpha.71",
  "description": "AWS S3 storage adapter for Nextly - supports S3, Cloudflare R2, MinIO",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "check-types": "node ../../scripts/tsc.mjs --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "clean": "rimraf dist"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1155.0",
    "@aws-sdk/lib-storage": "^3.1155.0",
    "@aws-sdk/s3-request-presigner": "^3.1155.0"
  },
  "devDependencies": {
    "@nextlyhq/tsconfig": "workspace:*",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "nextly": "workspace:*",
    "tsdown": "^0.23.1",
    "typescript": "7.0.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^5.0.5"
  },
  "keywords": [
    "nextly",
    "storage",
    "s3",
    "aws",
    "cloudflare-r2",
    "minio",
    "digitalocean-spaces",
    "media",
    "upload"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nextlyhq/nextly.git",
    "directory": "packages/storage-s3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "homepage": "https://nextlyhq.com",
  "bugs": {
    "url": "https://github.com/nextlyhq/nextly/issues"
  },
  "author": "Nextly <contact@nextlyhq.com> (https://nextlyhq.com)"
}
