{
  // Build boundary: type-checks src/**; test files are excluded here and
  // checked by the repo test pipeline instead, matching the other plugin
  // packages. The vendored .txt asset is typed by src/vendor/scalar-bundle.d.ts.
  "extends": "@nextlyhq/tsconfig/base-bundler.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "baseUrl": "."
  },
  "include": ["src/**/*"],
  "exclude": ["dist", "node_modules", "**/*.test.ts"]
}
