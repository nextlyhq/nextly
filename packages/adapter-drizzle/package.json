{
  "name": "@nextlyhq/adapter-drizzle",
  "version": "0.0.2-alpha.71",
  "description": "Shared Drizzle ORM adapter logic for Nextly database adapters",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.mjs",
      "require": "./dist/types/index.cjs"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema/index.mjs",
      "require": "./dist/schema/index.cjs"
    },
    "./migrations": {
      "types": "./dist/migrations.d.ts",
      "import": "./dist/migrations.mjs",
      "require": "./dist/migrations.cjs"
    },
    "./schema-name": {
      "types": "./dist/schema-name.d.ts",
      "import": "./dist/schema-name.mjs",
      "require": "./dist/schema-name.cjs"
    },
    "./text-match": {
      "types": "./dist/text-match.d.ts",
      "import": "./dist/text-match.mjs",
      "require": "./dist/text-match.cjs"
    },
    "./version-check": {
      "types": "./dist/version-check.d.ts",
      "import": "./dist/version-check.mjs",
      "require": "./dist/version-check.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "check-types": "node ../../scripts/tsc.mjs --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "clean": "rimraf dist"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "dependencies": {
    "drizzle-orm": "1.0.0-rc.4"
  },
  "devDependencies": {
    "@nextlyhq/tsconfig": "workspace:*",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "tsdown": "^0.23.2",
    "typescript": "7.0.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nextlyhq/nextly.git",
    "directory": "packages/adapter-drizzle"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "homepage": "https://nextlyhq.com",
  "bugs": {
    "url": "https://github.com/nextlyhq/nextly/issues"
  },
  "author": "Nextly <contact@nextlyhq.com> (https://nextlyhq.com)",
  "keywords": [
    "nextly",
    "drizzle",
    "drizzle-orm",
    "database",
    "adapter",
    "orm",
    "cms"
  ]
}
