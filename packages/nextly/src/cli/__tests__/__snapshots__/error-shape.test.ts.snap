// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`a command that ends with an error > adds the context and stack under --verbose, below the same plain message > with --verbose 1`] = `
"✗ \`nextly.config.ts\` has a syntax error, so it could not be read.
  Why:  nextly.config.ts:3:20: Expected "}" but found "fields"
  Next: Fix line 3 of \`nextly.config.ts\`, then run the command again.
  Docs: https://nextlyhq.com/docs/cli/errors/config-syntax-error  (CONFIG_SYNTAX_ERROR)

  Context: {"code":"INVALID_INPUT","configPath":"<project>/nextly.config.ts","reason":"load-error","cause":"Build failed with 1 error:\\nnextly.config.ts:3:20: ERROR: Expected \\"}\\" but found \\"fields\\""}
  Stack:
    Error: Build failed with 1 error:
    nextly.config.ts:3:20: ERROR: Expected "}" but found "fields"
    at <frames>"
`;

exports[`a command that ends with an error > adds the context and stack under --verbose, below the same plain message > without --verbose 1`] = `
