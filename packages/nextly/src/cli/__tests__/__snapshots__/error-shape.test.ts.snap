exports[`a command that ends with an error > names a missing configuration file, the flag that named it, and what to do 1`] = `
"✗ \`-c missing.config.ts\` names a configuration file that does not exist.
  Why:  Nothing is at <project>/missing.config.ts.
  Next: Pass \`-c\` the path of your configuration file, relative to the project folder, or leave \`-c\` out to use the project's \`nextly.config.ts\`.
  Docs: https://nextlyhq.com/docs/cli/errors/config-not-found  (CONFIG_NOT_FOUND)"
`;

exports[`a rollback refused for want of consent > ends with what it would delete and the consent that allows it, running nothing 1`] = `
"✗ Deleting data needs consent, and no terminal is attached to ask.
  Why:  This would delete:
        - 20261020_120000_add_summary.sql's DOWN, which drops a table or column, or empties a table
        Nothing was changed.
  Next: To consent: --accept-data-loss (or NEXTLY_ACCEPT_DATA_LOSS=1).
  Docs: https://nextlyhq.com/docs/cli/errors/data-loss-consent-required  (DATA_LOSS_CONSENT_REQUIRED)"
`;

exports[`each code, as a command ends with it > ADMIN_EMAIL_IN_USE 1`] = `
"✗ An account already uses that email. Nothing was created.
  Why:  That account would be given the administrator role and keep its own password, so the password given would be ignored.
  Next: Choose another email.
  Docs: https://nextlyhq.com/docs/cli/errors/admin-email-in-use  (ADMIN_EMAIL_IN_USE)"
`;

exports[`each code, as a command ends with it > ADMIN_EMAIL_INVALID 1`] = `
"✗ No valid email was given for the administrator.
  Why:  \`ada@\` is not an email address.
  Next: Give a valid email with \`--email\`.
  Docs: https://nextlyhq.com/docs/cli/errors/admin-email-invalid  (ADMIN_EMAIL_INVALID)"
`;

exports[`each code, as a command ends with it > ADMIN_NAME_MISSING 1`] = `
