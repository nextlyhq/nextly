  \`id\` varchar(36) PRIMARY KEY NOT NULL,
  \`pinned_id\` varchar(36) NOT NULL,
  \`tags_id\` varchar(36) NOT NULL,
  \`created_at\` timestamp DEFAULT CURRENT_TIMESTAMP NOT NULL,
  CONSTRAINT \`fk_dc_pinned_dc_tags_tags_pinned\` FOREIGN KEY (\`pinned_id\`) REFERENCES \`dc_pinned\`(\`id\`) ON DELETE CASCADE ON UPDATE NO ACTION,
  CONSTRAINT \`fk_dc_pinned_dc_tags_tags_tags\` FOREIGN KEY (\`tags_id\`) REFERENCES \`dc_tags\`(\`id\`) ON DELETE CASCADE ON UPDATE NO ACTION,
  CONSTRAINT \`uq_dc_pinned_dc_tags_tags_pair\` UNIQUE (\`pinned_id\`, \`tags_id\`)
);
