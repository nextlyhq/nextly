"-- Create dynamic collection: dc_pinned
CREATE TABLE IF NOT EXISTS \`dc_pinned\` (
  \`id\` varchar(36) PRIMARY KEY NOT NULL,
  \`slug\` varchar(255) NOT NULL,
  \`created_at\` timestamp DEFAULT CURRENT_TIMESTAMP,
  \`updated_at\` timestamp DEFAULT CURRENT_TIMESTAMP,
  \`created_by\` varchar(191),
\`title\` text NOT NULL,
\`slug_key\` text  UNIQUE,
\`short_code\` varchar(120),
\`summary\` text,
\`views\` integer,
\`rating\` decimal(10,2),
\`published\` boolean,
\`published_at\` timestamp,
\`payload\` json,
\`lookup_code\` text,
\`author\` varchar(36),
\`editors\` varchar(36),
\`state\` text   DEFAULT 'draft',
\`blocks\` text,
\`meta\` text,
  CONSTRAINT \`chk_dc_pinned_validation\` CHECK (LENGTH(\`title\`) >= 3 AND \`title\` REGEXP '^[A-Za-z0-9 ]+$' AND \`views\` >= 0 AND \`views\` <= 10000),
  CONSTRAINT \`fk_dc_pinned_author\` FOREIGN KEY (\`author\`) REFERENCES \`dc_authors\`(\`id\`) ON DELETE CASCADE ON UPDATE CASCADE
);
