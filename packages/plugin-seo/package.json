{
  "name": "@nextlyhq/plugin-seo",
  "version": "0.0.2-alpha.75",
  "description": "First-party SEO plugin for Nextly: adds an SEO meta field group to content collections",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./admin": {
      "types": "./dist/admin/index.d.ts",
      "import": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "check-types": "node ../../scripts/tsc.mjs --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@nextlyhq/plugin-sdk": "workspace:*",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@nextlyhq/admin": "0.0.2-alpha.75",
    "@nextlyhq/ui": "workspace:^",
    "lucide-react": ">=0.400.0",
    "nextly": "0.0.2-alpha.75",
    "react": "^19.3.0",
    "react-hook-form": "^7.66.0",
    "sharp": "^0.35.5"
  },
  "peerDependenciesMeta": {
    "@nextlyhq/admin": {
      "optional": true
    },
    "@nextlyhq/ui": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    },
    "react": {
      "optional": true
    },
