{
  "name": "@nextlyhq/ui",
  "version": "0.0.2-alpha.68",
  "description": "Nextly UI — Reusable React component library for Nextly plugins and custom admin UIs",
  "license": "MIT",
  "keywords": [
    "nextly",
    "ui",
    "components",
    "react",
    "radix",
    "tailwind"
  ],
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./tailwind-preset": {
      "import": {
        "types": "./dist/tailwind-preset.d.ts",
        "default": "./dist/tailwind-preset.mjs"
      },
      "require": {
        "types": "./dist/tailwind-preset.d.cts",
        "default": "./dist/tailwind-preset.cjs"
      }
    },
    "./utils": {
      "import": {
        "types": "./dist/utils.d.ts",
        "default": "./dist/utils.mjs"
      },
      "require": {
        "types": "./dist/utils.d.cts",
        "default": "./dist/utils.cjs"
      }
    },
    "./color": {
      "import": {
        "types": "./dist/color.d.ts",
        "default": "./dist/color.mjs"
      },
      "require": {
        "types": "./dist/color.d.cts",
        "default": "./dist/color.cjs"
      }
    },
    "./format": {
      "import": {
        "types": "./dist/format.d.ts",
        "default": "./dist/format.mjs"
      },
      "require": {
        "types": "./dist/format.d.cts",
        "default": "./dist/format.cjs"
      }
    },
    "./theme.css": "./dist/theme.css",
    "./styles.css": "./dist/styles.css",
    "./styles.scoped.css": "./dist/styles.scoped.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "docs",
    "!dist/metafile-*.json"
  ],
  "scripts": {
    "build": "pnpm build:js && node scripts/build-css.mjs",
    "build:js": "rimraf dist && tsdown --config-loader tsx && tsdown --config-loader tsx --config tsdown.server-safe.config.ts && tsx scripts/check-client-directive.ts && tsx scripts/check-server-safe-artifacts.ts",
    "build:css": "node scripts/build-css.mjs",
    "build:surface-declarations": "tsx scripts/build-surface-declarations.ts",
    "dev": "node scripts/dev.mjs",
    "check-types": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "clean": "rimraf dist"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "peerDependencies": {
    "lucide-react": ">=0.400.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@nextlyhq/admin-css": "workspace:*",
    "@nextlyhq/eslint-config": "workspace:*",
    "@nextlyhq/module-specifiers": "workspace:*",
    "@nextlyhq/tsconfig": "workspace:*",
    "@tailwindcss/cli": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/culori": "^4.0.1",
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/coverage-v8": "^4.1.0",
    "@vitest/ui": "^4.1.0",
    "culori": "^4.0.2",
    "eslint": "^9.39.1",
    "jsdom": "^27.1.0",
    "lucide-react": "^0.544.0",
    "postcss": "^8.5.31",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-virtual": "^3.14.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "react-resizable-panels": "^4.14.7",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nextlyhq/nextly.git",
    "directory": "packages/ui"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "homepage": "https://nextlyhq.com",
  "bugs": {
    "url": "https://github.com/nextlyhq/nextly/issues"
  },
  "author": "Nextly <contact@nextlyhq.com> (https://nextlyhq.com)"
}
