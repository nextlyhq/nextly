{
  "name": "@nextlyhq/eslint-plugin",
  "version": "0.0.2-alpha.76",
  "description": "ESLint rules that keep Nextly admin UI on the design-token system and flag experimental plugin SDK use — for first-party packages and for plugins built by anyone else.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nextlyhq/nextly.git",
    "directory": "packages/eslint-plugin"
  },
  "homepage": "https://nextlyhq.com/docs/plugins",
  "bugs": {
    "url": "https://github.com/nextlyhq/nextly/issues"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./vocabulary": "./src/vocabulary.js"
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "generate": "node scripts/sdk-stability.mjs"
  },
  "peerDependencies": {
    "eslint": ">=9.0.0"
  },
  "devDependencies": {
    "eslint": "^9.39.1",
    "oxc-parser": "^0.155.0",
    "oxlint": "1.89.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "nextly",
    "nextly-plugin",
    "design-tokens"
  ]
}
