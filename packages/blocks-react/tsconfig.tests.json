{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    // Off for tests: they publish no declarations, and `tsconfig.json` already
    // holds every shipped file to it.
    "isolatedDeclarations": false
  },
  "include": ["src/**/*"],
  "exclude": ["dist", "node_modules"]
}
