{
  "name": "@nextlyhq/plugin-form-builder",
  "version": "0.0.2-alpha.71",
  "description": "Visual form builder plugin for Nextly with Code-First and Schema Builder support",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./admin": {
      "types": "./dist/admin/index.d.ts",
      "import": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "check-types": "node ../../scripts/tsc.mjs --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@nextlyhq/admin": "0.0.2-alpha.71",
    "@nextlyhq/plugin-sdk": "workspace:*",
    "@nextlyhq/ui": "workspace:^",
    "@tanstack/react-query": ">=5.0.0",
    "lucide-react": ">=0.400.0",
    "next": "^15.5.28 || ^16.4.1",
    "nextly": "0.0.2-alpha.71",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@nextlyhq/admin": "workspace:*",
    "@nextlyhq/plugin-sdk": "workspace:*",
    "@nextlyhq/tsconfig": "workspace:*",
    "@nextlyhq/ui": "workspace:*",
    "@tanstack/react-query": "^5.104.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "jsdom": "^27.1.0",
    "lucide-react": "^0.544.0",
    "nextly": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsdown": "^0.23.2",
    "typescript": "7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "keywords": [
    "nextly",
    "nextly-plugin",
    "plugin",
    "forms",
    "form-builder",
    "cms",
    "headless-cms"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nextlyhq/nextly.git",
    "directory": "packages/plugin-form-builder"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "homepage": "https://nextlyhq.com",
  "bugs": {
    "url": "https://github.com/nextlyhq/nextly/issues"
  },
  "author": "Nextly <contact@nextlyhq.com> (https://nextlyhq.com)"
}
