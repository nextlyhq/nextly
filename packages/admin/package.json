{
  "name": "@nextlyhq/admin",
  "version": "0.0.2-alpha.70",
  "description": "Nextly - Admin dashboard and management interface",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./lib/component-registry": {
      "types": "./dist/lib/plugins/component-registry.d.ts",
      "import": "./dist/lib/plugins/component-registry.mjs",
      "default": "./dist/lib/plugins/component-registry.mjs"
    },
    "./lib/plugin-components": {
      "types": "./dist/lib/plugins/plugin-components.d.ts",
      "import": "./dist/lib/plugins/plugin-components.mjs",
      "default": "./dist/lib/plugins/plugin-components.mjs"
    },
    "./style.css": "./dist/styles/globals.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown && node scripts/build-css.mjs && node scripts/stamp-dist.mjs",
    "build:css": "node scripts/build-css.mjs",
    "build:css:watch": "node scripts/build-css-watch.mjs",
    "dev": "node scripts/dev.mjs",
    "check-types": "node ../../scripts/tsc.mjs --noEmit",
    "check:published-build": "node scripts/check-published-build.mjs",
    "report:bundle": "node scripts/bundle-report.mjs",
    "test": "node scripts/ensure-dist.mjs && vitest run",
    "test:watch": "node scripts/ensure-dist.mjs && vitest",
    "test:ui": "node scripts/ensure-dist.mjs && vitest --ui",
    "test:coverage": "node scripts/ensure-dist.mjs && vitest run --coverage",
    "clean": "rimraf dist",
    "analyze": "ANALYZE=true pnpm build"
  },
  "bin": {
    "create-admin-app": "dist/cli.cjs"
  },
  "peerDependencies": {
    "@nextlyhq/ui": "workspace:^",
