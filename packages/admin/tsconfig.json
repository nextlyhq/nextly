{
  "extends": "@nextlyhq/tsconfig/react-library-bundler.json",
  "compilerOptions": {
    // The common directory of every input, as TypeScript infers it today:
    // `paths` below map `nextly` to its source, so inputs sit in `../nextly`
    // as well as here. TypeScript 7 defaults `rootDir` to this directory and
    // would refuse them (TS6059).
    "rootDir": "..",
    "types": ["node"],
    "target": "ES2020",
    "emitDeclarationOnly": false,
    "outDir": "dist",
    "paths": {
      "nextly": ["../nextly/src"],
      // The gate the layout endpoint and the browser BOTH decide with. Mapped
      // to source because a bare subpath resolves through the package exports
      // to `dist`, which does not exist until something builds -- so static
      // analysis reports it unresolved on a clean checkout even though tsc and
      // the bundler are fine after a build. The bare `nextly` mapping above
      // does not cover subpaths.
      "nextly/widget-gate": ["../nextly/src/domains/widgets/gate.ts"],
      // Same reason, and a second one: the root entry reaches the DI
      // container and the auth middleware, whose `@nextly/*` aliases this
      // project does not define, so importing it here reports a hundred
      // errors about code the admin never touches.
      "nextly/document-lock": [
        "../nextly/src/domains/document-lock/contract.ts"
      ],
      // Same reason again: the wire shapes a widget query answers with, whose
      // `types` and `import` conditions point at different built paths.
      "nextly/widget-result": ["../nextly/src/domains/widgets/result.ts"],
      // Same reason: the translation states the worklist asks the server for.
      "nextly/translation-filter-states": [
        "../nextly/src/domains/i18n/translation-filter-states.ts"
      ],
      // Same reason: the keys a linked filter keeps at its top level.
      "nextly/reserved-filter-keys": [
        "../nextly/src/domains/collections/query/reserved-filter-keys.ts"
      ],
      // Same reason: the kinds and keys Needs attention's answer is written in.
      "nextly/attention-keys": [
        "../nextly/src/domains/widgets/attention-keys.ts"
      ],
      "@admin/*": ["./src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
