# Dev playground env. create-nextly-app writes dev/.env from this file;
# copy it again to start over.
DB_DIALECT=sqlite
# Relative to the plugin root, where `pnpm dev` runs (`next dev dev` keeps
# that working directory), so the database lands in dev/.
DATABASE_URL=file:./dev/nextly-dev.db

# Any non-empty secret works for local dev (sign/verify session cookies).
NEXTLY_SECRET=dev-secret-change-me

NEXT_PUBLIC_SITE_URL=http://localhost:3000
