#!/usr/bin/env sh

# Skip in CI. The release workflow does an internal `git push` (via
# `changesets/action`) when it commits version bumps; CI's `ci.yml`
# already runs the same lint+build validation as a separate gated step.
# Running them again here is redundant and broke the release flow:
# `pnpm turbo lint` runs *before* `pnpm run build` in this hook, so
# in CI (where the turbo cache is fresh) lint can't resolve workspace
# package imports until build has produced the dist outputs.
#
# Local pushes still get the full pre-push validation.
if [ -n "$CI" ]; then
  echo "Pre-push hook skipped in CI (validated by .github/workflows/ci.yml)"
  exit 0
fi

# Git exports GIT_DIR into every hook, and in a worktree it names that
# worktree's admin directory (<main>/.git/worktrees/<name>) rather than a
# plain .git. Turbo shells out to git to hash inputs, inherits that pointer,
# and never returns: `turbo run build` prints its task list and then sits
# there, burning ~2s of CPU over 25 minutes. Pushing from the main checkout
# is unaffected, because there GIT_DIR is an ordinary .git — which is why
# this looked like a turbo cache problem for a long time, and is not one.
#
# Clearing it costs nothing anywhere else: with no GIT_DIR set, git falls
# back to discovering the repository from the working directory, and hooks
# already run from the top of the working tree. That resolves to the same
# repository in a normal clone and to the correct worktree in a linked one,
# on every platform. GIT_WORK_TREE is cleared with it because the two are
# read as a pair; git does not currently set it for this hook, and unsetting
# something already unset is a no-op.
unset GIT_DIR GIT_WORK_TREE

set -e

# The two repo-wide lints CI gates on that `turbo lint` does not run. Both
# finish in well under a second, and neither was reachable from any hook, so
# knowing they existed was something each person carried privately: an `hsl()`
# literal reached a theme file whose every other token is OKLCH, and an
# out-of-order dependency key failed a build, each costing a CI round trip to
# learn something a local prompt could have said immediately.
pnpm lint:design
pnpm lint:workspace

pnpm turbo lint --continue \
  --filter='./packages/*'
pnpm run build

# The TESTS of the packages this branch actually changes.
#
# Two gaps this closes, and both were real. The lint above filters to
# `./packages/*`, which excludes `apps/*` and `e2e` — workspaces this repo
# declares and this hook could not reach. And nothing here ran tests at all, so
# a guard that lives in a TEST was unreachable from any hook: a public-export
# surface snapshot went unrun on two PRs, four names reached a published index
# unguarded, and `main` went red for every open PR, because the author's own
# gate was filtered to the package they had in mind rather than the ones they
# had edited.
#
# The scope is DERIVED from the diff rather than listed here, so it cannot go
# stale as packages are added. Empty means no workspace changed, and the run is
# skipped rather than becoming a whole-repo test sweep nobody would keep.
#
# Three outcomes, not two, and the status says which. A change that redefines
# the workspace or task graph cannot be narrowed to the packages it happens to
# sit beside, so it asks for the UNFILTERED run instead. Reporting that as a
# failure made those files impossible to push: this script runs under `set -e`,
# so it died before testing anything, and no retry could clear it because
# running the gates by hand does not change the diff. The only escape was
# bypassing the hook, which is worse than the narrowing being guarded against.
#
# `set +e` around the call only: the status IS the answer here, and letting the
# shell abort on a non-zero one would discard it.
set +e
GATE_FILTERS=$(node scripts/gate-scope.mjs --filters)
GATE_STATUS=$?
set -e

if [ "$GATE_STATUS" -eq 2 ]; then
  echo "pre-push: the diff redefines the workspace or task graph — testing every workspace."
  pnpm turbo test --continue
elif [ "$GATE_STATUS" -ne 0 ]; then
  echo "pre-push: gate-scope could not derive a trustworthy scope; refusing." >&2
  exit "$GATE_STATUS"
elif [ -n "$GATE_FILTERS" ]; then
  # shellcheck disable=SC2086 -- one flag per line, intentionally word-split
  pnpm turbo test --continue $GATE_FILTERS
fi
