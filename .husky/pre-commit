# Git exports GIT_DIR into every hook, this one included, and in a linked
# worktree it names that worktree's admin directory (<main>/.git/worktrees/
# <name>) rather than a plain .git. Both commands below drive the git CLI,
# which resolves that pointer correctly, so committing from a worktree works
# with it set — but that is a property of these two commands, not of the hook,
# and it lapses the moment either changes or a third is added. turbo, which
# the pre-push hook runs, hangs forever on the same pointer. Clearing it here
# makes "no hook inherits GIT_DIR" true of the hooks themselves rather than of
# whatever they happen to call.
#
# It costs nothing anywhere else: with no GIT_DIR set, git discovers the
# repository from the working directory, and hooks already run from the top of
# the working tree — the same repository in a normal clone, the same worktree
# in a linked one. GIT_WORK_TREE goes with it because git reads the two as a
# pair, and unsetting something already unset is a no-op.
unset GIT_DIR GIT_WORK_TREE

# Scan staged changes for committed secrets before
# lint-staged formats them. `gitleaks protect --staged` only inspects
# the index, so it's fast and accurate enough to catch common cases
# (API keys, private keys, AWS/GCP creds, etc).
#
# If gitleaks isn't installed locally, skip with a one-line nudge
# rather than block the commit — the GitHub Action enforces the same
# scan on PRs, so coverage is preserved at the merge gate.
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --redact --no-banner || {
    echo ""
    echo "✗ gitleaks found a potential secret in staged changes."
    echo "  Review the diff above. If it's a false positive, add an"
    echo "  exception to .gitleaks.toml (allowlist) and re-stage."
    exit 1
  }
else
  echo "ℹ gitleaks not installed locally — pre-commit secret scan skipped."
  echo "  Install: https://github.com/gitleaks/gitleaks#installing"
  echo "  CI will still run the scan on your PR."
fi

npx lint-staged
